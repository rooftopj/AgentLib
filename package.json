{
  "name": "agents-all-in-one",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run paper:registry && npm run blog:registry && npm run project:registry && npm run paper:validate && npm run blog:validate && npm run project:validate && npm run project:quality && npm run project:review && npm run annotations:validate && npm run content:index && next build",
    "start": "next start",
    "paper:new": "node scripts/new-paper.mjs",
    "paper:registry": "node scripts/generate-paper-registry.mjs",
    "paper:validate": "node scripts/validate-papers.mjs",
    "paper:index": "node scripts/generate-search-index.mjs",
    "blog:registry": "node scripts/generate-blog-registry.mjs",
    "blog:validate": "node scripts/validate-blogs.mjs",
    "project:registry": "node scripts/generate-project-registry.mjs",
    "project:validate": "node scripts/validate-projects.mjs",
    "project:quality": "node scripts/check-project-explainer-quality.mjs",
    "project:review": "node scripts/check-project-review.mjs",
    "annotations:export": "node .agents/skills/annotation-to-site/scripts/export-annotations.mjs",
    "annotations:validate": "node scripts/validate-annotations.mjs",
    "content:index": "node scripts/generate-search-index.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^15.3.2",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "next": "^15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "typescript": "^5.8.3"
  }
}
